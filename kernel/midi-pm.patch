SPDX-License-Identifier: GPL-2.0-only
Subject: [PATCH] Balance OCTA MIDI power holds across ports and URBs

Resume before taking MIDI lifecycle locks. Hold power for every successful
port open and pending URB; release completed, cancelled and rejected URBs
asynchronously. Retain the interface until late raw-MIDI closes complete.
Stop input retry timers from rearming a closed endpoint. Other device IDs
retain the imported ALSA lifetime power policy.

---
--- a/sound/usb/midi.c
+++ b/sound/usb/midi.c
@@ -114,6 +114,7 @@
 	unsigned int opened[2];
 	unsigned char disconnected;
 	unsigned char input_running;
+	bool runtime_pm;
 
 	struct snd_kcontrol *roland_load_ctl;
 };
@@ -174,9 +175,17 @@
 /*
  * Submits the URB, with error handling.
  */
-static int snd_usbmidi_submit_urb(struct urb *urb, gfp_t flags)
-{
-	int err = usb_submit_urb(urb, flags);
+static int snd_usbmidi_submit_urb(struct snd_usb_midi *umidi,
+				  struct urb *urb, gfp_t flags)
+{
+	int err;
+
+	/* An open port or the previous completion keeps the device awake. */
+	if (umidi->runtime_pm)
+		usb_autopm_get_interface_no_resume(umidi->iface);
+	err = usb_submit_urb(urb, flags);
+	if (err < 0 && umidi->runtime_pm)
+		usb_autopm_put_interface_async(umidi->iface);
 	if (err < 0 && err != -ENODEV)
 		dev_err(&urb->dev->dev, "usb_submit_urb: %d\n", err);
 	return err;
@@ -253,12 +262,17 @@
 				mod_timer(&ep->umidi->error_timer,
 					  jiffies + ERROR_DELAY_JIFFIES);
 			}
-			return;
-		}
-	}
-
-	urb->dev = ep->umidi->dev;
-	snd_usbmidi_submit_urb(urb, GFP_ATOMIC);
+			goto put_pm;
+		}
+	}
+
+	if (READ_ONCE(ep->umidi->input_running)) {
+		urb->dev = ep->umidi->dev;
+		snd_usbmidi_submit_urb(ep->umidi, urb, GFP_ATOMIC);
+	}
+put_pm:
+	if (ep->umidi->runtime_pm)
+		usb_autopm_put_interface_async(ep->umidi->iface);
 }
 
 static void snd_usbmidi_out_urb_complete(struct urb *urb)
@@ -282,10 +296,13 @@
 			if (err != -ENODEV)
