 }
 
-static int substream_open(struct snd_rawmidi_substream *substream, int dir,
-			  int open)
+static int substream_update(struct snd_rawmidi_substream *substream, int dir,
+			    int open)
 {
 	struct snd_usb_midi *umidi = substream->rmidi->private_data;
 	struct snd_kcontrol *ctl;
@@ -1192,6 +1209,27 @@
 	mutex_unlock(&umidi->mutex);
 	up_read(&umidi->disc_rwsem);
 	return 0;
+}
+
+/* Resume outside locks taken by the USB suspend/resume callbacks. */
+static int substream_open(struct snd_rawmidi_substream *substream, int dir,
+			  int open)
+{
+	struct snd_usb_midi *umidi = substream->rmidi->private_data;
+	int err;
+
+	if (!umidi->runtime_pm)
+		return substream_update(substream, dir, open);
+	if (open) {
+		err = usb_autopm_get_interface(umidi->iface);
+		if (err < 0)
+			return err;
+	}
+	err = substream_update(substream, dir, open);
+	/* Closing after disconnect still releases the successful open's hold. */
+	if (!open || err < 0)
+		usb_autopm_put_interface(umidi->iface);
+	return err;
 }
 
 static int snd_usbmidi_output_open(struct snd_rawmidi_substream *substream)
@@ -1536,6 +1574,8 @@
 		kfree(ep->out);
 	}
 	mutex_destroy(&umidi->mutex);
+	if (umidi->runtime_pm)
+		usb_put_intf(umidi->iface);
 	kfree(umidi);
 }
 
@@ -2439,15 +2479,20 @@
 	unsigned int i, j;
 
 	umidi = list_entry(p, struct snd_usb_midi, list);
