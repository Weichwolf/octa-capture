Subject: [PATCH] Standalone OCTA-CAPTURE audio, MIDI, status and PCM meters

Adapt private ALSA sources; shared device code is supplied by prepare-alsa.sh.

---
--- a/sound/usb/Makefile
+++ b/sound/usb/Makefile
@@ -5,6 +5,10 @@
-
-snd-usb-audio-y := 	card.o \
-			clock.o \
-			endpoint.o \
-			fcp.o \
-			format.o \
+
+snd-usb-audio-y := 	card.o \
+			clock.o \
+			octa-peaks.o \
+			octa-monitor.o \
+			octa.o \
+			octa-status.o \
+			endpoint.o \
+			fcp.o \
+			format.o \
--- a/sound/usb/card.c
+++ b/sound/usb/card.c
@@ -55,9 +55,10 @@
-#include "power.h"
-#include "stream.h"
-#include "media.h"
-
-MODULE_AUTHOR("Takashi Iwai <tiwai@suse.de>");
-MODULE_DESCRIPTION("USB Audio");
-MODULE_LICENSE("GPL");
-
-static int index[SNDRV_CARDS] = SNDRV_DEFAULT_IDX;	/* Index 0-MAX */
+#include "power.h"
+#include "stream.h"
+#include "media.h"
+#include "octa.h"
+
+MODULE_AUTHOR("Takashi Iwai <tiwai@suse.de>");
+MODULE_DESCRIPTION("Roland OCTA-CAPTURE audio and MIDI");
+MODULE_LICENSE("GPL");
+
+static int index[SNDRV_CARDS] = SNDRV_DEFAULT_IDX;	/* Index 0-MAX */
@@ -604,7 +605,9 @@
-{
-	struct snd_usb_audio *chip = card->private_data;
-
-	snd_usb_endpoint_free_all(chip);
-	snd_usb_midi_v2_free_all(chip);
-
-	mutex_destroy(&chip->mutex);
+{
+	struct snd_usb_audio *chip = card->private_data;
+
+	snd_usb_octa_capture_pcm_shutdown(chip);
+	snd_usb_endpoint_free_all(chip);
+	snd_usb_octa_capture_free_pcm(chip);
+	snd_usb_midi_v2_free_all(chip);
+
+	mutex_destroy(&chip->mutex);
@@ -807,6 +810,12 @@
-	usb_audio_make_longname(dev, chip, quirk);
-
-	snd_usb_audio_create_proc(chip);
-
-	*rchip = chip;
-	return 0;
+	usb_audio_make_longname(dev, chip, quirk);
+
+	snd_usb_audio_create_proc(chip);
+
+	err = snd_usb_octa_capture_add_controls(chip);
+	if (err < 0) {
+		snd_card_free(card);
+		return err;
+	}
+
+	*rchip = chip;
+	return 0;
@@ -1102,6 +1111,7 @@
-		struct snd_usb_endpoint *ep;
-		struct usb_mixer_interface *mixer;
-
-		/* wait until all pending tasks done;
-		 * they are protected by snd_usb_lock_shutdown()
-		 */
+		struct snd_usb_endpoint *ep;
+		struct usb_mixer_interface *mixer;
+
+		snd_usb_octa_capture_pcm_shutdown(chip);
+		/* wait until all pending tasks done;
+		 * they are protected by snd_usb_lock_shutdown()
+		 */
@@ -1239,6 +1249,7 @@
-		return 0;
-
-	if (!chip->num_suspended_intf++) {
-		list_for_each_entry(as, &chip->pcm_list, list)
-			snd_usb_pcm_suspend(as);
-		list_for_each_entry(ep, &chip->ep_list, list)
+		return 0;
+
+	if (!chip->num_suspended_intf++) {
+		snd_usb_octa_capture_pcm_suspend(chip, PMSG_IS_AUTO(message));
+		list_for_each_entry(as, &chip->pcm_list, list)
+			snd_usb_pcm_suspend(as);
+		list_for_each_entry(ep, &chip->ep_list, list)
@@ -1313,18 +1324,17 @@
-		chip->system_suspend = 0;
-	}
-	chip->num_suspended_intf--;
-
-err_out:
-	atomic_dec(&chip->active); /* allow autopm after this point */
-	return err;
-}
-
-static const struct usb_device_id usb_audio_ids [] = {
-#include "quirks-table.h"
-    { .match_flags = (USB_DEVICE_ID_MATCH_INT_CLASS | USB_DEVICE_ID_MATCH_INT_SUBCLASS),
-      .bInterfaceClass = USB_CLASS_AUDIO,
-      .bInterfaceSubClass = USB_SUBCLASS_AUDIOCONTROL },
-    { }						/* Terminating entry */
-};
-MODULE_DEVICE_TABLE(usb, usb_audio_ids);
-
+		chip->system_suspend = 0;
+	}
+	chip->num_suspended_intf--;
+	if (!chip->num_suspended_intf)
+		snd_usb_octa_capture_pcm_resume(chip);
+
+err_out:
+	atomic_dec(&chip->active); /* allow autopm after this point */
+	return err;
+}
+
+static const struct usb_device_id usb_audio_ids[] = {
+#include "octa-id.h"
+	{ } /* Terminating entry */
+};
+MODULE_DEVICE_TABLE(usb, usb_audio_ids);
+
@@ -1333,7 +1343,7 @@
- */
-
-static struct usb_driver usb_audio_driver = {
-	.name =		"snd-usb-audio",
-	.probe =	usb_audio_probe,
-	.disconnect =	usb_audio_disconnect,
-	.suspend =	usb_audio_suspend,
+ */
+
+static struct usb_driver usb_audio_driver = {
+	.name =		"snd-octa-capture",
+	.probe =	usb_audio_probe,
+	.disconnect =	usb_audio_disconnect,
+	.suspend =	usb_audio_suspend,
--- a/sound/usb/clock.c
+++ b/sound/usb/clock.c
@@ -19,6 +19,7 @@
-#include "card.h"
-#include "helper.h"
-#include "clock.h"
-#include "quirks.h"
-
-union uac23_clock_source_desc {
+#include "card.h"
+#include "helper.h"
+#include "clock.h"
