+++ b/sound/usb/octa-status.c
@@ -0,0 +1,154 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Read-only OCTA-CAPTURE status pipe; independent of audio and CTRL MIDI. */
+#include <linux/errno.h>
+#include <linux/mutex.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+#include <linux/usb.h>
+
+#include <sound/control.h>
+#include <sound/core.h>
+
+#include "usbaudio.h"
+#include "octa.h"
+
+#define OCTA_STATUS_INTERFACE 3
+#define OCTA_STATUS_ALTSETTING 1
+#define OCTA_STATUS_ENDPOINT 0x82
+#define OCTA_STATUS_BYTES 8
+#define OCTA_STATUS_PACKETS 4
+#define OCTA_STATUS_TIMEOUT_MS 250
+
+struct octa_status {
+	struct snd_usb_audio *chip;
+	struct mutex lock; /* Serializes status reads and alternate selection. */
+};
+
+static int octa_status_prepare(struct snd_usb_audio *chip)
+{
+	struct usb_interface *intf;
+	struct usb_host_interface *alt;
+	const struct usb_endpoint_descriptor *ep;
+
+	intf = usb_ifnum_to_if(chip->dev, OCTA_STATUS_INTERFACE);
+	if (!intf)
+		return -ENODEV;
+	alt = usb_altnum_to_altsetting(intf, OCTA_STATUS_ALTSETTING);
+	if (!alt || alt->desc.bNumEndpoints != 1)
+		return -EINVAL;
+	ep = &alt->endpoint[0].desc;
+	if (!usb_endpoint_is_int_in(ep) ||
+	    ep->bEndpointAddress != OCTA_STATUS_ENDPOINT ||
+	    usb_endpoint_maxp(ep) != OCTA_STATUS_BYTES)
+		return -EINVAL;
+
+	if (intf->cur_altsetting->desc.bAlternateSetting == OCTA_STATUS_ALTSETTING)
+		return 0;
+	return usb_set_interface(chip->dev, OCTA_STATUS_INTERFACE,
+				 OCTA_STATUS_ALTSETTING);
+}
+
+static int octa_status_read(struct snd_usb_audio *chip, u8 *packet)
+{
+	bool seen_zero = false;
+	int attempt, actual, err;
+
+	for (attempt = 0; attempt < OCTA_STATUS_PACKETS; attempt++) {
+		actual = 0;
+		err = usb_interrupt_msg(chip->dev,
+					usb_rcvintpipe(chip->dev, OCTA_STATUS_ENDPOINT),
+					packet, OCTA_STATUS_BYTES, &actual,
+					OCTA_STATUS_TIMEOUT_MS);
+		if (err < 0)
+			return err;
+		if (actual != OCTA_STATUS_BYTES)
+			return -EIO;
+		if (packet[0] > 1)
+			return -EPROTO;
+		if (!packet[0]) {
+			seen_zero = true;
+			continue;
+		}
+		if (seen_zero) {
+			if (!(packet[3] | packet[4] | packet[5]))
+				return -ENODATA;
+			return 0;
+		}
+	}
+	return -EAGAIN;
+}
+
+static int octa_status_info(struct snd_kcontrol *kcontrol,
+			    struct snd_ctl_elem_info *uinfo)
+{
+	uinfo->type = SNDRV_CTL_ELEM_TYPE_BYTES;
+	uinfo->count = OCTA_STATUS_BYTES;
+	return 0;
+}
+
+static int octa_status_get(struct snd_kcontrol *kcontrol,
+			   struct snd_ctl_elem_value *ucontrol)
+{
+	struct octa_status *status = snd_kcontrol_chip(kcontrol);
+	u8 *packet;
+	int err;
+
+	err = mutex_lock_interruptible(&status->lock);
+	if (err)
+		return err;
+	err = snd_usb_lock_shutdown(status->chip);
+	if (err < 0)
+		goto unlock;
+
+	/* USB DMA buffers must not live on the stack. */
+	packet = kmalloc(OCTA_STATUS_BYTES, GFP_KERNEL);
+	if (!packet) {
+		err = -ENOMEM;
+		goto release;
+	}
+	err = octa_status_prepare(status->chip);
+	if (!err)
+		err = octa_status_read(status->chip, packet);
+	if (!err)
+		memcpy(ucontrol->value.bytes.data, packet, OCTA_STATUS_BYTES);
+	kfree(packet);
+release:
+	snd_usb_unlock_shutdown(status->chip);
+unlock:
+	mutex_unlock(&status->lock);
+	return err;
+}
+
+static void octa_status_free(struct snd_kcontrol *kcontrol)
+{
+	kfree(snd_kcontrol_chip(kcontrol));
+}
+
+int snd_usb_octa_capture_add_controls(struct snd_usb_audio *chip)
+{
+	static const struct snd_kcontrol_new control = {
+		.iface = SNDRV_CTL_ELEM_IFACE_CARD,
+		.name = "OCTA-CAPTURE Status",
+		.access = SNDRV_CTL_ELEM_ACCESS_READ | SNDRV_CTL_ELEM_ACCESS_VOLATILE,
+		.info = octa_status_info,
+		.get = octa_status_get,
+	};
+	struct octa_status *status;
+	struct snd_kcontrol *kcontrol;
+
+	if (chip->usb_id != USB_ID(0x0582, 0x0120))
+		return 0;
+	status = kzalloc(sizeof(*status), GFP_KERNEL);
+	if (!status)
+		return -ENOMEM;
+	status->chip = chip;
+	mutex_init(&status->lock);
+	kcontrol = snd_ctl_new1(&control, status);
+	if (!kcontrol) {
+		kfree(status);
+		return -ENOMEM;
+	}
+	kcontrol->private_free = octa_status_free;
+	/* snd_ctl_add owns/frees the control, including its private data. */
+	return snd_ctl_add(chip->card, kcontrol);
+}
--- /dev/null
+++ b/sound/usb/octa.c
@@ -0,0 +1,108 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Roland OCTA-CAPTURE vendor clock control. */
+
+#include <linux/delay.h>
+#include <linux/usb.h>
+
+#include <sound/core.h>
+
+#include "usbaudio.h"
+#include "helper.h"
+#include "octa.h"
+
+#define OCTA_CLOCK_REQUEST 3
+#define OCTA_POLL_ATTEMPTS 40
+#define OCTA_POLL_DELAY_MS 200
+
+static int octa_read_status(struct snd_usb_audio *chip, u16 value,
+			    u8 *data, u16 size)
+{
+	int err;
+
+	err = snd_usb_ctl_msg(chip->dev, usb_rcvctrlpipe(chip->dev, 0),
+			      OCTA_CLOCK_REQUEST,
+			      USB_DIR_IN | USB_TYPE_VENDOR | USB_RECIP_DEVICE,
+			      value, 0, data, size);
+	if (err < 0)
+		return err;
+	return err == size ? 0 : -EIO;
+}
+
+static int octa_get_rate(struct snd_usb_audio *chip, int *rate, u8 *flags)
+{
+	u8 data[4];
+	int err;
+
+	err = octa_read_status(chip, 1, data, sizeof(data));
+	if (err < 0)
+		return err;
+	*rate = data[0] | (data[1] << 8) | (data[2] << 16);
+	*flags = data[3];
+	return 0;
+}
+
+static int octa_wait_ready(struct snd_usb_audio *chip)
+{
+	u8 ready;
+	int attempt, err;
+
+	for (attempt = 0; attempt < OCTA_POLL_ATTEMPTS; attempt++) {
+		err = octa_read_status(chip, 2, &ready, sizeof(ready));
+		if (err < 0)
+			return err;
+		if (ready == 1)
+			return 0;
+		msleep(OCTA_POLL_DELAY_MS);
+	}
+	return -ETIMEDOUT;
+}
+
+int snd_usb_octa_capture_set_rate(struct snd_usb_audio *chip, int rate)
+{
+	u8 data[4], flags;
+	int current_rate, attempt, err;
+
+	switch (rate) {
+	case 44100:
+	case 48000:
+	case 96000:
+	case 192000:
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	err = octa_get_rate(chip, &current_rate, &flags);
+	if (err < 0)
+		return err;
+	if (flags & 2)
+		return -EIO;
+	if (current_rate == rate && !(flags & 1))
+		return octa_wait_ready(chip);
+
+	/* 0x40 changes the clock; 0x01 only negotiates the current rate. */
+	data[0] = current_rate == rate ? 1 : 0x40;
+	data[1] = rate;
+	data[2] = rate >> 8;
+	data[3] = rate >> 16;
+	err = snd_usb_ctl_msg(chip->dev, usb_sndctrlpipe(chip->dev, 0),
+			      OCTA_CLOCK_REQUEST,
+			      USB_DIR_OUT | USB_TYPE_VENDOR | USB_RECIP_DEVICE,
+			      8, 0, data, sizeof(data));
+	if (err < 0)
+		return err;
+	if (err != sizeof(data))
+		return -EIO;
+
+	for (attempt = 0; attempt < OCTA_POLL_ATTEMPTS; attempt++) {
+		err = octa_get_rate(chip, &current_rate, &flags);
+		if (err < 0)
+			return err;
+		if (current_rate != rate || (flags & 2))
+			return -EIO;
+		if (!(flags & 1))
+			return octa_wait_ready(chip);
+		msleep(OCTA_POLL_DELAY_MS);
+	}
+	return -ETIMEDOUT;
+}
--- /dev/null
+++ b/sound/usb/octa.h
@@ -0,0 +1,11 @@
