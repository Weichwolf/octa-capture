Subject: [PATCH] Standalone OCTA-CAPTURE audio, MIDI and read-only status

Use descriptor formats, vendor clock setup and both MIDI cables.
Expose the bounded status pipe through a read-only ALSA control,
without userspace interface detachment or audio-path changes.

---
--- a/sound/usb/Makefile
+++ b/sound/usb/Makefile
@@ -5,6 +5,8 @@
 
 snd-usb-audio-y := 	card.o \
 			clock.o \
+			octa.o \
+			octa-status.o \
 			endpoint.o \
 			fcp.o \
 			format.o \
--- a/sound/usb/card.c
+++ b/sound/usb/card.c
@@ -55,9 +55,10 @@
 #include "power.h"
 #include "stream.h"
 #include "media.h"
+#include "octa.h"
 
 MODULE_AUTHOR("Takashi Iwai <tiwai@suse.de>");
-MODULE_DESCRIPTION("USB Audio");
+MODULE_DESCRIPTION("Roland OCTA-CAPTURE audio and MIDI");
 MODULE_LICENSE("GPL");
 
 static int index[SNDRV_CARDS] = SNDRV_DEFAULT_IDX;	/* Index 0-MAX */
@@ -811,3 +812,9 @@
-	*rchip = chip;
-	return 0;
+	err = snd_usb_octa_capture_add_controls(chip);
+	if (err < 0) {
+		snd_card_free(card);
+		return err;
+	}
+
+	*rchip = chip;
+	return 0;
 }
@@ -1319,12 +1326,9 @@
 	return err;
 }
 
-static const struct usb_device_id usb_audio_ids [] = {
-#include "quirks-table.h"
-    { .match_flags = (USB_DEVICE_ID_MATCH_INT_CLASS | USB_DEVICE_ID_MATCH_INT_SUBCLASS),
-      .bInterfaceClass = USB_CLASS_AUDIO,
-      .bInterfaceSubClass = USB_SUBCLASS_AUDIOCONTROL },
-    { }						/* Terminating entry */
+static const struct usb_device_id usb_audio_ids[] = {
+#include "octa-id.h"
+	{ } /* Terminating entry */
 };
 MODULE_DEVICE_TABLE(usb, usb_audio_ids);
 
@@ -1333,7 +1337,7 @@
  */
 
 static struct usb_driver usb_audio_driver = {
-	.name =		"snd-usb-audio",
+	.name =		"snd-octa-capture",
 	.probe =	usb_audio_probe,
 	.disconnect =	usb_audio_disconnect,
 	.suspend =	usb_audio_suspend,
--- a/sound/usb/clock.c
+++ b/sound/usb/clock.c
@@ -19,6 +19,7 @@
 #include "card.h"
 #include "helper.h"
 #include "clock.h"
+#include "octa.h"
 #include "quirks.h"
 
 union uac23_clock_source_desc {
@@ -664,6 +665,9 @@
 	usb_audio_dbg(chip, "%d:%d Set sample rate %d, clock %d\n",
 		      fmt->iface, fmt->altsetting, rate, fmt->clock);
 
+	if (chip->usb_id == USB_ID(0x0582, 0x0120))
+		return snd_usb_octa_capture_set_rate(chip, rate);
+
 	switch (fmt->protocol) {
 	case UAC_VERSION_1:
 	default:
--- a/sound/usb/endpoint.c
+++ b/sound/usb/endpoint.c
@@ -1487,7 +1487,8 @@
 	/* Some UAC1 devices (e.g. Yamaha THR10) need the host interface
 	 * to be set up before parameter setups
 	 */
-	iface_first = ep->cur_audiofmt->protocol == UAC_VERSION_1;
+	iface_first = ep->cur_audiofmt->protocol == UAC_VERSION_1 &&
+		chip->usb_id != USB_ID(0x0582, 0x0120);
 	/* Workaround for devices that require the interface setup at first like UAC1 */
 	if (chip->quirk_flags & QUIRK_FLAG_SET_IFACE_FIRST)
 		iface_first = true;
--- a/sound/usb/stream.c
+++ b/sound/usb/stream.c
@@ -1243,6 +1243,13 @@
 				return err;
 		}
 
+		/*
+		 * OCTA-CAPTURE has a device-wide vendor clock. Do not change
+		 * its rate or select streaming interfaces while enumerating.
+		 */
+		if (chip->usb_id == USB_ID(0x0582, 0x0120))
+			continue;
+
 		set_iface_first = false;
 		if (protocol == UAC_VERSION_1 ||
 		    (chip->quirk_flags & QUIRK_FLAG_SET_IFACE_FIRST))
