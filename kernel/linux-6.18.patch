-		      fmt->iface, fmt->altsetting, rate, fmt->clock);
-
-	switch (fmt->protocol) {
-	case UAC_VERSION_1:
-	default:
+	usb_audio_dbg(chip, "%d:%d Set sample rate %d, clock %d\n",
+		      fmt->iface, fmt->altsetting, rate, fmt->clock);
+
+	if (chip->usb_id == USB_ID(0x0582, 0x0120))
+		return snd_usb_octa_capture_set_rate(chip, rate);
+
+	switch (fmt->protocol) {
+	case UAC_VERSION_1:
+	default:
--- a/sound/usb/endpoint.c
+++ b/sound/usb/endpoint.c
@@ -14,6 +14,7 @@
-#include <sound/pcm_params.h>
-
-#include "usbaudio.h"
-#include "helper.h"
-#include "card.h"
-#include "endpoint.h"
+#include <sound/pcm_params.h>
+
+#include "usbaudio.h"
+#include "octa.h"
+#include "helper.h"
+#include "card.h"
+#include "endpoint.h"
@@ -246,6 +247,7 @@
-static void retire_outbound_urb(struct snd_usb_endpoint *ep,
-				struct snd_urb_ctx *urb_ctx)
-{
-	call_retire_callback(ep, urb_ctx->urb);
-}
-
+static void retire_outbound_urb(struct snd_usb_endpoint *ep,
+				struct snd_urb_ctx *urb_ctx)
+{
+	snd_usb_octa_capture_pcm_retire(ep, urb_ctx);
+	call_retire_callback(ep, urb_ctx->urb);
+}
+
@@ -268,6 +270,7 @@
-	if (sync_sink)
-		snd_usb_handle_sync_urb(sync_sink, ep, urb);
-
-	call_retire_callback(ep, urb);
-}
-
+	if (sync_sink)
+		snd_usb_handle_sync_urb(sync_sink, ep, urb);
+
+	snd_usb_octa_capture_pcm_retire(ep, urb_ctx);
+	call_retire_callback(ep, urb);
+}
+
@@ -1487,7 +1490,8 @@
-	/* Some UAC1 devices (e.g. Yamaha THR10) need the host interface
-	 * to be set up before parameter setups
-	 */
-	iface_first = ep->cur_audiofmt->protocol == UAC_VERSION_1;
-	/* Workaround for devices that require the interface setup at first like UAC1 */
-	if (chip->quirk_flags & QUIRK_FLAG_SET_IFACE_FIRST)
-		iface_first = true;
+	/* Some UAC1 devices (e.g. Yamaha THR10) need the host interface
+	 * to be set up before parameter setups
+	 */
+	iface_first = ep->cur_audiofmt->protocol == UAC_VERSION_1 &&
+		chip->usb_id != USB_ID(0x0582, 0x0120);
+	/* Workaround for devices that require the interface setup at first like UAC1 */
+	if (chip->quirk_flags & QUIRK_FLAG_SET_IFACE_FIRST)
+		iface_first = true;
--- a/sound/usb/stream.c
+++ b/sound/usb/stream.c
@@ -1243,6 +1243,13 @@
-				return err;
-		}
-
-		set_iface_first = false;
-		if (protocol == UAC_VERSION_1 ||
-		    (chip->quirk_flags & QUIRK_FLAG_SET_IFACE_FIRST))
+				return err;
+		}
+
+		/*
+		 * OCTA-CAPTURE has a device-wide vendor clock. Do not change
+		 * its rate or select streaming interfaces while enumerating.
+		 */
+		if (chip->usb_id == USB_ID(0x0582, 0x0120))
+			continue;
+
+		set_iface_first = false;
+		if (protocol == UAC_VERSION_1 ||
+		    (chip->quirk_flags & QUIRK_FLAG_SET_IFACE_FIRST))
--- a/sound/usb/pcm.c
+++ b/sound/usb/pcm.c
@@ -15,6 +15,7 @@
-#include <sound/pcm_params.h>
-
-#include "usbaudio.h"
-#include "card.h"
-#include "quirks.h"
-#include "endpoint.h"
+#include <sound/pcm_params.h>
+
+#include "usbaudio.h"
+#include "octa.h"
+#include "card.h"
+#include "quirks.h"
+#include "endpoint.h"
@@ -1253,7 +1254,7 @@
-	    as->chip->lowlatency)
-		runtime->hw.info |= SNDRV_PCM_INFO_SYNC_APPLPTR;
-	runtime->private_data = subs;
-	subs->pcm_substream = substream;
-	/* runtime PM is also done there */
-
-	/* initialize DSD/DOP context */
+	    as->chip->lowlatency)
+		runtime->hw.info |= SNDRV_PCM_INFO_SYNC_APPLPTR;
+	runtime->private_data = subs;
+	WRITE_ONCE(subs->pcm_substream, substream);
+	/* runtime PM is also done there */
+
+	/* initialize DSD/DOP context */
@@ -1261,12 +1262,14 @@
-	subs->dsd_dop.channel = 0;
-	subs->dsd_dop.marker = 1;
-
-	ret = setup_hw_info(runtime, subs);
-	if (ret < 0)
-		goto err_open;
-	ret = snd_usb_autoresume(subs->stream->chip);
-	if (ret < 0)
-		goto err_open;
-	ret = snd_media_stream_init(subs, as->pcm, direction);
-	if (ret < 0)
-		goto err_resume;
+	subs->dsd_dop.channel = 0;
+	subs->dsd_dop.marker = 1;
+
+	ret = snd_usb_autoresume(subs->stream->chip);
+	if (ret < 0)
+		goto err_open;
+	/* Release idle meter endpoints before computing PCM constraints. */
+	snd_usb_octa_capture_pcm_yield(chip);
+	ret = setup_hw_info(runtime, subs);
+	if (ret < 0)
+		goto err_resume;
+	ret = snd_media_stream_init(subs, as->pcm, direction);
+	if (ret < 0)
+		goto err_resume;
@@ -1276,6 +1279,7 @@
-err_resume:
-	snd_usb_autosuspend(subs->stream->chip);
-err_open:
-	scoped_guard(mutex, &chip->mutex) {
-		subs->opened = 0;
-	}
+err_resume:
+	snd_usb_autosuspend(subs->stream->chip);
+err_open:
+	WRITE_ONCE(subs->pcm_substream, NULL);
+	scoped_guard(mutex, &chip->mutex) {
+		subs->opened = 0;
+	}
@@ -1302,7 +1306,7 @@
-			return ret;
-	}
-
-	subs->pcm_substream = NULL;
-	snd_usb_autosuspend(subs->stream->chip);
-	scoped_guard(mutex, &chip->mutex) {
-		subs->opened = 0;
+			return ret;
+	}
+
+	WRITE_ONCE(subs->pcm_substream, NULL);
+	snd_usb_autosuspend(subs->stream->chip);
+	scoped_guard(mutex, &chip->mutex) {
+		subs->opened = 0;
