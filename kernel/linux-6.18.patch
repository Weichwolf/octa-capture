Subject: [PATCH] Build OCTA-CAPTURE with descriptor formats and vendor clock control

Use a dedicated USB ID table, expose the CTRL MIDI cable, and configure
the device-wide clock when preparing audio streams. Keep enumeration from
changing the clock or starting alternate settings.

---
--- a/sound/usb/Makefile
+++ b/sound/usb/Makefile
@@ -5,6 +5,7 @@
 
 snd-usb-audio-y := 	card.o \
 			clock.o \
+			octa.o \
 			endpoint.o \
 			fcp.o \
 			format.o \
--- a/sound/usb/card.c
+++ b/sound/usb/card.c
@@ -57,7 +57,7 @@
 #include "media.h"
 
 MODULE_AUTHOR("Takashi Iwai <tiwai@suse.de>");
-MODULE_DESCRIPTION("USB Audio");
+MODULE_DESCRIPTION("Roland OCTA-CAPTURE audio and MIDI");
 MODULE_LICENSE("GPL");
 
 static int index[SNDRV_CARDS] = SNDRV_DEFAULT_IDX;	/* Index 0-MAX */
@@ -1319,12 +1319,9 @@
 	return err;
 }
 
-static const struct usb_device_id usb_audio_ids [] = {
-#include "quirks-table.h"
-    { .match_flags = (USB_DEVICE_ID_MATCH_INT_CLASS | USB_DEVICE_ID_MATCH_INT_SUBCLASS),
-      .bInterfaceClass = USB_CLASS_AUDIO,
-      .bInterfaceSubClass = USB_SUBCLASS_AUDIOCONTROL },
-    { }						/* Terminating entry */
+static const struct usb_device_id usb_audio_ids[] = {
+#include "octa-id.h"
+	{ } /* Terminating entry */
 };
 MODULE_DEVICE_TABLE(usb, usb_audio_ids);
 
@@ -1333,7 +1330,7 @@
  */
 
 static struct usb_driver usb_audio_driver = {
-	.name =		"snd-usb-audio",
+	.name =		"snd-octa-capture",
 	.probe =	usb_audio_probe,
 	.disconnect =	usb_audio_disconnect,
 	.suspend =	usb_audio_suspend,
--- a/sound/usb/clock.c
+++ b/sound/usb/clock.c
@@ -19,6 +19,7 @@
 #include "card.h"
 #include "helper.h"
 #include "clock.h"
+#include "octa.h"
 #include "quirks.h"
 
 union uac23_clock_source_desc {
@@ -664,6 +665,9 @@
 	usb_audio_dbg(chip, "%d:%d Set sample rate %d, clock %d\n",
 		      fmt->iface, fmt->altsetting, rate, fmt->clock);
 
+	if (chip->usb_id == USB_ID(0x0582, 0x0120))
+		return snd_usb_octa_capture_set_rate(chip, rate);
+
 	switch (fmt->protocol) {
 	case UAC_VERSION_1:
 	default:
--- a/sound/usb/endpoint.c
+++ b/sound/usb/endpoint.c
@@ -1487,7 +1487,8 @@
 	/* Some UAC1 devices (e.g. Yamaha THR10) need the host interface
 	 * to be set up before parameter setups
 	 */
-	iface_first = ep->cur_audiofmt->protocol == UAC_VERSION_1;
+	iface_first = ep->cur_audiofmt->protocol == UAC_VERSION_1 &&
+		chip->usb_id != USB_ID(0x0582, 0x0120);
 	/* Workaround for devices that require the interface setup at first like UAC1 */
 	if (chip->quirk_flags & QUIRK_FLAG_SET_IFACE_FIRST)
 		iface_first = true;
--- /dev/null
+++ b/sound/usb/octa-id.h
@@ -0,0 +1,32 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Included inside this module's USB ID table. */
+{
+	USB_DEVICE(0x0582, 0x0120),
+	.driver_info = (unsigned long)&(const struct snd_usb_audio_quirk) {
+		.vendor_name = "Roland",
+		.product_name = "OCTA-CAPTURE",
+		.ifnum = QUIRK_ANY_INTERFACE,
+		.type = QUIRK_COMPOSITE,
+		.data = &(const struct snd_usb_audio_quirk[]) {
+			{
+				.ifnum = 0,
+				.type = QUIRK_AUDIO_STANDARD_INTERFACE
+			},
+			{
+				.ifnum = 1,
+				.type = QUIRK_AUDIO_STANDARD_INTERFACE
+			},
+			{
+				.ifnum = 2,
+				.type = QUIRK_MIDI_FIXED_ENDPOINT,
+				.data = &(const struct snd_usb_midi_endpoint_info) {
+					.out_cables = 0x0003,
+					.in_cables = 0x0003
+				}
+			},
+			{ .ifnum = 3, .type = QUIRK_IGNORE_INTERFACE },
+			{ .ifnum = 4, .type = QUIRK_IGNORE_INTERFACE },
+			{ .ifnum = -1 }
+		}
+	}
+},
--- /dev/null
+++ b/sound/usb/octa.c
@@ -0,0 +1,108 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Roland OCTA-CAPTURE vendor clock control. */
+
+#include <linux/delay.h>
+#include <linux/usb.h>
+
+#include <sound/core.h>
+
+#include "usbaudio.h"
+#include "helper.h"
+#include "octa.h"
+
+#define OCTA_CLOCK_REQUEST 3
+#define OCTA_POLL_ATTEMPTS 40
+#define OCTA_POLL_DELAY_MS 200
+
+static int octa_read_status(struct snd_usb_audio *chip, u16 value,
+			    u8 *data, u16 size)
+{
+	int err;
+
+	err = snd_usb_ctl_msg(chip->dev, usb_rcvctrlpipe(chip->dev, 0),
+			      OCTA_CLOCK_REQUEST,
+			      USB_DIR_IN | USB_TYPE_VENDOR | USB_RECIP_DEVICE,
+			      value, 0, data, size);
+	if (err < 0)
+		return err;
+	return err == size ? 0 : -EIO;
+}
+
+static int octa_get_rate(struct snd_usb_audio *chip, int *rate, u8 *flags)
+{
+	u8 data[4];
+	int err;
+
+	err = octa_read_status(chip, 1, data, sizeof(data));
+	if (err < 0)
+		return err;
+	*rate = data[0] | (data[1] << 8) | (data[2] << 16);
+	*flags = data[3];
+	return 0;
+}
+
+static int octa_wait_ready(struct snd_usb_audio *chip)
+{
+	u8 ready;
+	int attempt, err;
+
+	for (attempt = 0; attempt < OCTA_POLL_ATTEMPTS; attempt++) {
+		err = octa_read_status(chip, 2, &ready, sizeof(ready));
+		if (err < 0)
+			return err;
+		if (ready == 1)
+			return 0;
+		msleep(OCTA_POLL_DELAY_MS);
+	}
+	return -ETIMEDOUT;
+}
+
+int snd_usb_octa_capture_set_rate(struct snd_usb_audio *chip, int rate)
+{
+	u8 data[4], flags;
+	int current_rate, attempt, err;
+
+	switch (rate) {
+	case 44100:
+	case 48000:
+	case 96000:
+	case 192000:
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	err = octa_get_rate(chip, &current_rate, &flags);
+	if (err < 0)
+		return err;
+	if (flags & 2)
+		return -EIO;
+	if (current_rate == rate && !(flags & 1))
+		return octa_wait_ready(chip);
+
+	/* 0x40 changes the clock; 0x01 only negotiates the current rate. */
+	data[0] = current_rate == rate ? 1 : 0x40;
+	data[1] = rate;
+	data[2] = rate >> 8;
+	data[3] = rate >> 16;
+	err = snd_usb_ctl_msg(chip->dev, usb_sndctrlpipe(chip->dev, 0),
+			      OCTA_CLOCK_REQUEST,
+			      USB_DIR_OUT | USB_TYPE_VENDOR | USB_RECIP_DEVICE,
+			      8, 0, data, sizeof(data));
+	if (err < 0)
+		return err;
+	if (err != sizeof(data))
+		return -EIO;
+
+	for (attempt = 0; attempt < OCTA_POLL_ATTEMPTS; attempt++) {
+		err = octa_get_rate(chip, &current_rate, &flags);
+		if (err < 0)
+			return err;
+		if (current_rate != rate || (flags & 2))
+			return -EIO;
+		if (!(flags & 1))
+			return octa_wait_ready(chip);
+		msleep(OCTA_POLL_DELAY_MS);
+	}
+	return -ETIMEDOUT;
+}
--- /dev/null
+++ b/sound/usb/octa.h
@@ -0,0 +1,9 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef __USBAUDIO_OCTA_H
+#define __USBAUDIO_OCTA_H
+
+struct snd_usb_audio;
+
+int snd_usb_octa_capture_set_rate(struct snd_usb_audio *chip, int rate);
+
+#endif /* __USBAUDIO_OCTA_H */
--- a/sound/usb/stream.c
+++ b/sound/usb/stream.c
@@ -1243,6 +1243,13 @@
 				return err;
 		}
 
+		/*
+		 * OCTA-CAPTURE has a device-wide vendor clock. Do not change
+		 * its rate or select streaming interfaces while enumerating.
+		 */
+		if (chip->usb_id == USB_ID(0x0582, 0x0120))
+			continue;
+
 		set_iface_first = false;
 		if (protocol == UAC_VERSION_1 ||
 		    (chip->quirk_flags & QUIRK_FLAG_SET_IFACE_FIRST))
