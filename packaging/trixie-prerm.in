#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
set -eu

case "$1" in
    remove|deconfigure)
        if [ -z "${DPKG_ROOT:-}" ] && [ -d /run/systemd/system ]; then
            deb-systemd-invoke --user stop octa-capture-audio.service
        fi
        ;;
esac

case "$1" in
    remove|upgrade|deconfigure)
        if [ -d '/var/lib/dkms/snd-octa-capture/@VERSION@' ]; then
            dkms remove -m snd-octa-capture -v '@VERSION@' --all
        fi
        ;;
esac

#DEBHELPER#
