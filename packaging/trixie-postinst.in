#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
set -eu

if [ "$1" = configure ]; then
    /usr/lib/dkms/common.postinst snd-octa-capture '@VERSION@' \
        /usr/share/doc/octa-capture '' "${2-}"
    if [ -z "${DPKG_ROOT:-}" ]; then
        udev_active=false
        if command -v udevadm >/dev/null 2>&1 && udevadm control --ping >/dev/null 2>&1; then
            udevadm control --reload-rules
            udev_active=true
        fi
        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload
            # Only the matching USB device is rebound; no GUI runs as root.
            for vendor in /sys/bus/usb/devices/*/idVendor; do
                [ -r "$vendor" ] || continue
                device=${vendor%/idVendor}
                if [ "$(cat "$vendor")" != 0582 ] || [ "$(cat "$device/idProduct")" != 0120 ]; then
                    continue
                fi
                if "$udev_active"; then
                    udevadm trigger --action=change --settle --subsystem-match=sound \
                        --parent-match="$device" --sysname-match='card[0-9]*'
                fi
                flock --exclusive --timeout 20 /run/octa-capture-activate.lock /usr/sbin/octa-capture-activate
                break
            done
        fi
    fi
fi

#DEBHELPER#

# Compatibility level 13 enables user units but does not start running managers.
if [ "$1" = configure ] && [ -z "${DPKG_ROOT:-}" ] && [ -d /run/systemd/system ]; then
    deb-systemd-invoke --user daemon-reload
    deb-systemd-invoke --user restart octa-capture-audio.service
fi
