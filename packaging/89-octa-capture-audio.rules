# SPDX-License-Identifier: GPL-2.0-only
# Defer PCM opening until the user service has read the hardware clock.
ACTION!="remove", SUBSYSTEM=="sound", KERNEL=="card[0-9]*", ATTRS{idVendor}=="0582", ATTRS{idProduct}=="012[01]", ENV{PULSE_PROFILE_SET}="octa-capture-pending.conf", ENV{PULSE_MODARGS}="use_ucm=no profile=off"
